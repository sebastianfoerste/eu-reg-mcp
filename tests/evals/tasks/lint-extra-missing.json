{
  "id": "lint-extra-missing",
  "description": "Without the lint extra: extra_missing with an install hint.",
  "setup": "no_extras",
  "call": {
    "tool": "lint_micar_whitepaper",
    "arguments": {
      "whitepaper_json": "{}"
    }
  },
  "expect": {
    "isError": true,
    "equals": {
      "code": "extra_missing",
      "available": false
    },
    "contains": {
      "hint": "eu-reg-mcp[lint]"
    }
  }
}
