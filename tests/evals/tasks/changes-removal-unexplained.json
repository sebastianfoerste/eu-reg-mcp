{
  "id": "changes-removal-unexplained",
  "description": "A removal says the register does not state why and is no longer listed.",
  "setup": "fixtures",
  "call": {
    "tool": "micar_register_changes",
    "arguments": {
      "change_type": "removed"
    }
  },
  "expect": {
    "isError": false,
    "equals": {
      "changes.0.entry_id": "a3",
